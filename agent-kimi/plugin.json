{
  "name": "agent-kimi",
  "displayName": "Kimi Code Agent",
  "version": "1.1.0",
  "description": "Connect the installed Kimi Code CLI to FiveLeaf over ACP. Sign in and configure a model in `kimi` before opening a chat.",
  "enabled": false,
  "contributes": {
    "agentServers": [
      {
        "id": "agent-kimi.acp",
        "name": "Kimi Code",
        "command": "kimi",
        "args": [
          "acp"
        ],
        "capabilities": [
          "code",
          "reasoning",
          "search"
        ]
      }
    ]
  }
}
